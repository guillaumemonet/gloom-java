<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Récupération des assets au premier lancement (ils ne sont PAS redistribuables,
         cf. README §6 : l'APK est vierge, comme le paquet jpackage). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- vue 3D (jMonkeyEngine) : OpenGL ES 2.0 minimum -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="Gloom"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <activity
            android:name="gloom.android.GloomActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La 3D tourne dans SON PROPRE PROCESSUS. Le moteur est un gros paquet de statiques
             (Mem.RAM, Vars, Assets) : un processus neuf garantit à jMonkeyEngine un état vierge,
             sans rien hériter de ce que la partie 2D aurait laissé en mémoire. -->
        <activity
            android:name="gloom.android3d.RebirthActivity"
            android:exported="false"
            android:process=":rebirth"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
